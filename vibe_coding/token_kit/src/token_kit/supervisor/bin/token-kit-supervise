#!/usr/bin/env bash
# token-kit-supervise -- thin shim over token_kit.supervisor.main. See that file.
# Same cached-interpreter trick as respawn-reader: `uv run` spends ~65-95 ms
# resolving an interpreter that costs ~17 ms to start, and a watcher re-invokes
# this shim on every rollover.
set -euo pipefail
# This shim is LINKED into ~/.config/token_kit/bin, so its own path must be
# resolved before anything is computed relative to it: dirname of the SYMLINK
# points at the bin dir, not at the clone, and the import would fail there.
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SRC="$(cd "$(dirname "$SELF")/../../.." && pwd)"   # .../token_kit/src
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/token_kit/python"
if [ ! -x "$CACHE" ]; then
  mkdir -p "$(dirname "$CACHE")"
  uv run --python '>=3.11' --no-project python -c 'import sys;print(sys.executable)' \
    > "$CACHE.tmp.$$" 2>/dev/null && ln -sf "$(cat "$CACHE.tmp.$$")" "$CACHE"
  rm -f "$CACHE.tmp.$$"
fi
if [ -x "$CACHE" ]; then
  exec env PYTHONPATH="$SRC${PYTHONPATH:+:$PYTHONPATH}" "$CACHE" \
    -m token_kit.supervisor.main "$@"
fi
exec env PYTHONPATH="$SRC${PYTHONPATH:+:$PYTHONPATH}" \
  uv run --python '>=3.11' --no-project python -m token_kit.supervisor.main "$@"
